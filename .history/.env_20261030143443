# ============================================================
# IPMA Comunicados Sismológicos — Variáveis de Ambiente
# Copiar para .env e preencher os valores de produção
# ============================================================

# --- Base de Dados ---
POSTGRES_PASSWORD=sismos_dev_pwd
DATABASE_URL=postgresql://sismos:sismos_dev_pwd@localhost:5433/sismos

# --- JWT ---
JWT_SECRET=alterar_em_producao_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# --- FTP (Centro de Operações IPMA) ---
FTP_HOST=ftp.ipma.pt
FTP_USER=sismos
FTP_PASSWORD=
FTP_INCOMING_DIR=/sismos/incoming
FTP_PROCESSED_DIR=/sismos/processed
FTP_POLL_INTERVAL_MS=30000

# --- Email (SMTP IPMA) ---
SMTP_HOST=smtp.ipma.pt
SMTP_PORT=587
SMTP_USER=sismos@ipma.pt
SMTP_PASSWORD=
SMTP_FROM="IPMA Sismologia <sismos@ipma.pt>"

# --- SMS (SMSExpress MEO) ---
SMS_PROVIDER_URL=https://smsexpress.meo.pt/api/v2/send
SMS_API_KEY=
SMS_SENDER=IPMA-SISMOS

# --- Website IPMA ---
IPMA_WEBSITE_API_URL=

# --- App ---
APP_URL=http://localhost:9002
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:9002

# abre o .env e muda (ou adiciona)
PORT=9002
