# ============================================================
# IPMA Comunicados Sismológicos — Variáveis de Ambiente
# Copiar para .env e preencher os valores de produção
# ============================================================

# --- Base de Dados ---
POSTGRES_PASSWORD=sismos_dev_pwd
DATABASE_URL=postgresql://sismos:sismos_dev_pwd@localhost:5433/sismos

# --- Administrador inicial (seed) ---
# Obrigatório em produção; em desenvolvimento, sem estes valores, é usada a conta de demonstração.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# --- JWT ---
JWT_SECRET=alterar_em_producao_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# --- FTP (Centro de Operações IPMA) ---
FTP_HOST=ftp.ipma.pt
FTP_USER=sismos
FTP_PASSWORD=
FTP_INCOMING_DIR=/sismos/incoming
FTP_PROCESSED_DIR=/sismos/processed
FTP_POLL_INTERVAL_MS=30000

# --- Email (SMTP IPMA) ---
SMTP_HOST=smtp.ipma.pt
SMTP_PORT=587
SMTP_USER=sismos@ipma.pt
SMTP_PASSWORD=
SMTP_FROM="IPMA Sismologia <sismos@ipma.pt>"

# --- SMS (SMSExpress MEO) ---
SMS_PROVIDER_URL=https://smsexpress.meo.pt/api/v2/send
SMS_API_KEY=
SMS_SENDER=IPMA-SISMOS

# --- Website IPMA ---
# none (sem integração) | http (API REST do website) | ficheiro (pasta partilhada lida pelo website)
WEBSITE_PUBLISHER=none
IPMA_WEBSITE_API_URL=
IPMA_WEBSITE_API_TOKEN=
WEBSITE_PUBLICACAO_DIR=./website

# --- Ambiente ---
# production | test (envios só para contactos internos, sem website) | development
APP_ENV=development
# json em produção (recolha por Loki/ELK); pretty em desenvolvimento
LOG_FORMAT=pretty
LOG_LEVEL=log
# Se definido, /api/metrics exige "Authorization: Bearer <token>"
METRICS_TOKEN=

# --- Backups ---
BACKUP_DIR=./backups
BACKUP_MAX_IDADE_HORAS=26
BACKUP_INTERVALO_HORAS=6
BACKUP_RETENCAO_DIAS=30

# --- App ---
APP_URL=http://localhost:3002
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:9001
